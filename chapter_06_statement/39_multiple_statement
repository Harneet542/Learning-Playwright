let score = 78;
if (score >= 90) {
    console.log("A grade");
} else if (score >= 80 && score < 90) {
    console.log("B grade");
} else if (score >= 70 && score < 80) {
    console.log("C grade");
} else if (score >= 60 && score < 70) {
    console.log("D grade");
} else {
    console.log("F grade"); 
} 



